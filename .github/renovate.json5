{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":automergePr",
    ":disableRateLimiting",
    ":enablePreCommit",
    ":semanticCommits",
    ":separateMultipleMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":timezone(America/New_York)",
    "local>ninerealmlabs/precommit-template//.github/renovate/autoMerge.json5",
    "local>ninerealmlabs/precommit-template//.github/renovate/customManagers.json5",
    "local>ninerealmlabs/precommit-template//.github/renovate/labels.json5",
    "local>ninerealmlabs/precommit-template//.github/renovate/packageRules.json5",
    "local>ninerealmlabs/precommit-template//.github/renovate/semanticCommits.json5",
  ],
  dependencyDashboard: {
    enabled: true,
    title: "Renovate Dashboard 🤖",
  },
  schedule: ["before 5am"],
  minimumReleaseAge: "3 days",
}
