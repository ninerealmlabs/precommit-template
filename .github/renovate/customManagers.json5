{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      // Only the Jinja template needs this. A plain `.pre-commit-config.yaml` is covered by the
      // built-in `pre-commit` manager (see `:enablePreCommit`), which parses `repo:`/`rev:`
      // structurally — the `# renovate:` comments in these files are documentation, not config,
      // and any `versioning=` in them is ignored. Set versioning in packageRules.json5 instead.
      description: "Update pre-commit hook revs in Jinja template",
      managerFilePatterns: [
        "/(^|/)template/\\.pre-commit-config\\.ya?ml(?:\\.jinja)?$/"
      ],
      matchStrings: [
        // - repo: https://github.com/pre-commit/pre-commit-hooks
        //   rev: "v5.0.0"
        "(?ms)^\\s*-\\s*repo:\\s*https?://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)\\b.*?\\n\\s*rev:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:[-\\.+]\\w+(?:[-.\\w])*)*)[\"']?",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver-coerced",
    },
    {
      customType: "regex",
      // The schema version tracks the biome-check hook rather than the npm package, so both bump together
      // (grouped in packageRules.json5). Hook tags carry a `v` prefix; the schema URL does not.
      description: "Update the Biome config schema URL to match the biome-check hook",
      managerFilePatterns: [
        "/(^|/)\\.biome\\.jsonc$/",
        "/(^|/)template/.*\\.biome\\.jsonc.*\\.jinja$/",
      ],
      matchStrings: [
        // "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
        "\"\\$schema\":\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema\\.json\"",
      ],
      depNameTemplate: "biomejs/pre-commit",
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^v(?<version>.+)$",
      versioningTemplate: "semver",
    },
  ]
}
