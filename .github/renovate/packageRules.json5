{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Both wrappers tag as `<upstream version><separator><wrapper build number>`
      // (scop/pre-commit-shfmt: v3.13.1-1; shellcheck-py: v0.11.0.1). Neither is semver, and
      // semver-coerced drops the build number, masking wrapper-only bumps.
      description: "Support loose versioning for non-semver build-tagged wrapper releases",
      matchDepNames: [
        "scop/pre-commit-shfmt",
        "shellcheck-py/shellcheck-py",
      ],
      versioning: "loose",
    },
  ]
}
