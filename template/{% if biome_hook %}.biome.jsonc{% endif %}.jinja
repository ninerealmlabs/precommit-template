{%- raw -%}
{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "root": true,

  "files": {
{%- endraw %}
{#- Markdown stays out: mdformat and rumdl own it, and the biome-check hook passes `.md` files to biome. #}
{%- set web_exts = ["js", "ts", "jsx", "tsx", "json", "jsonc", "css", "html"] if biome_web else [] %}
{%- set yaml_exts = ["yaml", "yml"] if yaml else [] %}
{%- set formatted_glob = "**/*.{" ~ (web_exts + yaml_exts) | join(",") ~ "}" %}
    "includes": {{ [formatted_glob, "!!**/node_modules", "!!**/dist", "!!**/build"] | tojson }},
{%- raw %}
    "ignoreUnknown": true
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    // Biome's global formatter settings
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 119,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": true,
    "expand": "auto"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double", // closest to singleQuote: false
      "jsxQuoteStyle": "double",
      "quoteProperties": "preserve",
      "trailingCommas": "all", // matches Prettier trailingComma: "all"
      "semicolons": "asNeeded" // Biome uses `"asNeeded"` for no semis
    }
  },

  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },

  "css": {
    "parser": {
      "cssModules": true
    },
    "formatter": {
      "quoteStyle": "double"
    }
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "parser": {
      "interpolation": true
    },
    "formatter": {
      "enabled": true
    }
  }
{%- endraw %}{% if yaml %},

  // Matches `.yamllint.yaml`, whose `brackets` rule allows no spaces inside `[]`.
  // Biome's `yaml` settings have no `bracketSpacing`, so this override sets it for YAML files only.
  "overrides": [{ "includes": ["**/*.{yaml,yml}"], "formatter": { "bracketSpacing": false } }]
{%- endif %}{% raw %}
}
{%- endraw %}
